{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vite.config.ts", "related": true },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/**/*.ts",
    "!src/lib/ivs/**",
    "!src/lib/**/*.test.ts",
    "!src/lib/utils.ts",
    "!src/lib/query-keys.ts",
    "src/features/auth/guard.ts",
    "src/features/auth/password-schemas.ts",
    "src/features/viewer/send-block.ts",
    "src/features/slides/api.ts",
    "src/features/archives/api.ts",
    "src/features/admin/*-api.ts"
  ],
  "tempDirName": ".stryker-tmp-core",
  "reporters": ["clear-text", "html", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/core.html" },
  "thresholds": { "high": 90, "low": 80, "break": 80 }
}
