# infra/.env.<env>(例: .env.stg)にコピーして使う。-c key=value の context が優先される。
# 秘密情報は書かない(Okta の client secret は SSM SecureString に置き、ここにはパラメータ名だけ書く)。
DELIVERY_SES_FROM_EMAIL=
DELIVERY_COGNITO_DOMAIN_PREFIX=
DELIVERY_OKTA_ISSUER=
DELIVERY_OKTA_CLIENT_ID=
DELIVERY_OKTA_CLIENT_SECRET_PARAMETER=
DELIVERY_CLOUDFRONT_FREE_PLAN=
DELIVERY_CLOUDTRAIL=
